{
  "name": "signalk-livedepth-plugin",
  "version": "0.2.1",
  "description": "Gridded bathymetry tile store and LiveDepth chart layer for Signal K chartplotters.",
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-chart-plotters",
    "bathymetry",
    "depth",
    "sonar",
    "sounder",
    "marine"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "public",
    "icon.svg"
  ],
  "scripts": {
    "build": "npm run build:plugin && npm run typecheck:web && npm run build:web",
    "build:plugin": "tsc -b",
    "build:web": "node scripts/build-web.mjs",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "dev": "tsc -w",
    "prepack": "npm run build",
    "test": "vitest run",
    "format": "prettier --write .",
    "lint": "oxlint src test"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5",
    "@signalk/server-api": "^2.29.0",
    "stream-transform": "^3.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "esbuild": "^0.27.0",
    "express": "^5.1.0",
    "oxlint": "^1.74.0",
    "prettier": "^3.6.2",
    "signalk-plotterext-bus": "^0.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "signalk": {
    "displayName": "LiveDepth",
    "appIcon": "icon.svg"
  }
}
